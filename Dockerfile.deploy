# Upgrades must inherit the currently deployed web image so open pages can
# continue loading their content-hashed chunks. Only first installs use nginx.
ARG WEB_BASE_IMAGE
FROM ${WEB_BASE_IMAGE}
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html
RUN chmod -R a+rX /usr/share/nginx/html
